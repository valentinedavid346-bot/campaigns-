<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>David for Student Body President | Belmont Preparatory</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --black: #080010;
      --deep: #0f0019;
      --purple: #7c3aed;
      --purple-mid: #9b59b6;
      --purple-light: #c4b5fd;
      --purple-glow: rgba(124,58,237,0.15);
      --grey: #6b7280;
      --grey-light: #f8f7fa;
      --grey-mid: #e5e1eb;
      --white: #ffffff;
      --text: #111118;
      --text-muted: #6b7280;
    }
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; font-size:16px; }
    body { font-family:'Inter',sans-serif; background:var(--grey-light); color:var(--text); overflow-x:hidden; -webkit-font-smoothing:antialiased; }

    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width:4px; }
    ::-webkit-scrollbar-track { background:var(--black); }
    ::-webkit-scrollbar-thumb { background:var(--purple); border-radius:99px; }

    /* ── NAV ── */
    nav {
      position:fixed; top:0; left:0; right:0; z-index:999;
      display:flex; align-items:center; justify-content:space-between;
      padding:0 2.5rem; height:64px;
      background:rgba(8,0,16,0.85);
      backdrop-filter:blur(20px);
      border-bottom:1px solid rgba(124,58,237,0.15);
    }
    .nav-brand { display:flex; align-items:center; gap:0.6rem; text-decoration:none; }
    .nav-brand-dot { width:8px; height:8px; background:var(--purple); border-radius:50%; box-shadow:0 0 8px var(--purple); }
    .nav-brand-text { font-family:'Inter',sans-serif; font-weight:700; font-size:0.9rem; color:var(--white); letter-spacing:1px; text-transform:uppercase; }
    .nav-links { display:flex; gap:2rem; list-style:none; }
    .nav-links a { color:rgba(255,255,255,0.55); text-decoration:none; font-weight:500; font-size:0.8rem; letter-spacing:0.5px; text-transform:uppercase; transition:color 0.2s; }
    .nav-links a:hover { color:var(--white); }
    .nav-right { display:flex; align-items:center; gap:1rem; }
    .dark-toggle { background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); color:rgba(255,255,255,0.6); border-radius:99px; padding:0.4rem 1rem; font-size:0.75rem; font-weight:600; cursor:pointer; transition:all 0.2s; font-family:'Inter',sans-serif; }
    .dark-toggle:hover { border-color:var(--purple); color:var(--purple-light); }
    .nav-cta { background:var(--purple); color:var(--white); border:none; border-radius:99px; padding:0.5rem 1.2rem; font-size:0.8rem; font-weight:700; cursor:pointer; font-family:'Inter',sans-serif; letter-spacing:0.5px; transition:all 0.2s; text-decoration:none; }
    .nav-cta:hover { background:#6d28d9; transform:translateY(-1px); }

    /* ── DARK MODE ── */
    body.dark { background:#080010; color:#e8e0f5; }
    body.dark #meet, body.dark #recommend, body.dark #faq, body.dark #endorse { background:#0f0019; }
    body.dark #ideas, body.dark #blog { background:#080010; }
    body.dark .idea-card, body.dark .faq-item, body.dark .endorse-card, body.dark .blog-card { background:#1a0a2e; border-color:rgba(124,58,237,0.2); }
    body.dark .idea-card h3, body.dark .blog-body h3 { color:#e8e0f5; }
    body.dark .idea-card p, body.dark .blog-body p { color:rgba(232,224,245,0.6); }
    body.dark .section-title { color:#e8e0f5; }
    body.dark .section-desc { color:rgba(232,224,245,0.6); }
    body.dark .form-group input, body.dark .form-group textarea, body.dark .form-group select { background:#1a0a2e; border-color:rgba(124,58,237,0.3); color:#e8e0f5; }
    body.dark .rec-card { background:#1a0a2e; }
    body.dark .poll-option { background:#1a0a2e; border-color:rgba(124,58,237,0.2); }
    body.dark .faq-q { color:#e8e0f5; }
    body.dark .faq-a { color:rgba(232,224,245,0.65); }

    /* ── MARQUEE ── */
    .marquee-wrap { background:var(--purple); overflow:hidden; padding:0.5rem 0; }
    .marquee-track { display:inline-flex; animation:marquee 22s linear infinite; white-space:nowrap; }
    .marquee-track span { font-size:0.7rem; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:rgba(255,255,255,0.9); margin:0 3rem; }
    .marquee-track .sep { color:rgba(255,255,255,0.4); }
    @keyframes marquee { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

    /* ── HERO ── */
    #hero {
      min-height:100vh;
      background:var(--black);
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      text-align:center; padding:8rem 2rem 5rem;
      position:relative; overflow:hidden;
    }
    .hero-bg-orb {
      position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none;
    }
    .orb-1 { width:500px; height:500px; background:rgba(124,58,237,0.2); top:-100px; left:-100px; }
    .orb-2 { width:400px; height:400px; background:rgba(124,58,237,0.12); bottom:-80px; right:-80px; }
    .orb-3 { width:300px; height:300px; background:rgba(196,181,253,0.06); top:40%; left:50%; transform:translate(-50%,-50%); }
    .hero-eyebrow {
      display:inline-flex; align-items:center; gap:0.5rem;
      background:rgba(124,58,237,0.12); border:1px solid rgba(124,58,237,0.3);
      color:var(--purple-light); font-size:0.75rem; font-weight:600;
      letter-spacing:2px; text-transform:uppercase; padding:0.4rem 1.2rem;
      border-radius:99px; margin-bottom:2rem; position:relative; z-index:1;
    }
    .hero-eyebrow-dot { width:6px; height:6px; background:var(--purple-light); border-radius:50%; animation:pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.8)} }
    #hero h1 {
      font-family:'Playfair Display',serif;
      font-size:clamp(3.5rem,10vw,8rem);
      font-weight:900; color:var(--white);
      line-height:1.0; letter-spacing:-2px;
      position:relative; z-index:1;
      max-width:900px;
    }
    #hero h1 em { font-style:normal; color:var(--purple-light); }
    .hero-sub {
      font-size:1.15rem; color:rgba(255,255,255,0.5);
      margin:1.75rem 0 2.5rem; font-weight:400; line-height:1.7;
      max-width:520px; position:relative; z-index:1;
    }
    .hero-sub strong { color:rgba(255,255,255,0.8); font-weight:600; }
    .hero-btns { display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; position:relative; z-index:1; }
    .btn-primary {
      background:var(--purple); color:var(--white); border:none;
      padding:0.9rem 2.2rem; border-radius:12px; font-weight:700;
      font-size:0.9rem; cursor:pointer; font-family:'Inter',sans-serif;
      letter-spacing:0.3px; transition:all 0.2s; text-decoration:none;
      display:inline-block; box-shadow:0 0 0 0 rgba(124,58,237,0);
    }
    .btn-primary:hover { background:#6d28d9; transform:translateY(-2px); box-shadow:0 8px 30px rgba(124,58,237,0.4); }
    .btn-secondary {
      background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.8);
      border:1px solid rgba(255,255,255,0.12); padding:0.9rem 2.2rem;
      border-radius:12px; font-weight:600; font-size:0.9rem; cursor:pointer;
      font-family:'Inter',sans-serif; transition:all 0.2s; text-decoration:none; display:inline-block;
    }
    .btn-secondary:hover { background:rgba(255,255,255,0.1); border-color:rgba(255,255,255,0.25); }

    /* COUNTDOWN */
    .countdown-wrap { margin-top:4rem; position:relative; z-index:1; }
    .countdown-label { font-size:0.7rem; letter-spacing:3px; text-transform:uppercase; color:rgba(255,255,255,0.3); margin-bottom:1rem; font-weight:600; }
    .countdown-timer { display:flex; gap:0; }
    .countdown-unit { text-align:center; padding:0 1.5rem; border-right:1px solid rgba(255,255,255,0.08); }
    .countdown-unit:last-child { border-right:none; }
    .countdown-num { font-family:'Playfair Display',serif; font-size:3.5rem; color:var(--white); line-height:1; font-weight:700; }
    .countdown-unit-label { font-size:0.65rem; color:rgba(255,255,255,0.3); letter-spacing:2px; text-transform:uppercase; margin-top:0.3rem; }
    .countdown-date-row { margin-top:1.5rem; font-size:0.75rem; color:rgba(255,255,255,0.3); }
    .countdown-date-row input[type="date"] { background:rgba(255,255,255,0.06); border:1px solid rgba(124,58,237,0.3); border-radius:6px; color:rgba(255,255,255,0.6); padding:0.3rem 0.6rem; font-size:0.75rem; margin-left:0.5rem; font-family:'Inter',sans-serif; }

    .hero-divider { width:1px; height:80px; background:linear-gradient(to bottom,transparent,rgba(255,255,255,0.1),transparent); margin:3rem auto 0; position:relative; z-index:1; }

    /* ── SECTION BASE ── */
    section { padding:6rem 2rem; }
    .container { max-width:1140px; margin:0 auto; }
    .section-eyebrow { font-size:0.72rem; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--purple); margin-bottom:0.75rem; }
    .section-title { font-family:'Playfair Display',serif; font-size:clamp(2rem,5vw,3.2rem); font-weight:700; color:var(--text); line-height:1.15; letter-spacing:-0.5px; margin-bottom:1rem; }
    .section-desc { font-size:1rem; color:var(--text-muted); line-height:1.8; max-width:560px; margin-bottom:3rem; }
    .center { text-align:center; }
    .center .section-desc { margin-left:auto; margin-right:auto; }
    .title-white { color:var(--white) !important; }
    .desc-white { color:rgba(255,255,255,0.5) !important; }

    /* ── MEET ── */
    #meet { background:var(--white); }
    .meet-grid { display:grid; grid-template-columns:420px 1fr; gap:5rem; align-items:center; }
    .photo-outer { position:relative; }
    .photo-frame {
      width:100%; aspect-ratio:3/4;
      background:linear-gradient(160deg,#1a0a2e,#3b0764);
      border-radius:24px; overflow:hidden; position:relative;
      box-shadow:0 30px 80px rgba(0,0,0,0.2), 0 0 0 1px rgba(124,58,237,0.15);
    }
    .photo-frame img { width:100%; height:100%; object-fit:cover; display:none; }
    .photo-placeholder { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; color:rgba(255,255,255,0.3); gap:0.5rem; }
    .photo-placeholder svg { width:48px; height:48px; opacity:0.4; }
    .photo-placeholder p { font-size:0.8rem; font-weight:500; }
    .photo-accent { position:absolute; bottom:-16px; right:-16px; width:120px; height:120px; background:var(--purple); border-radius:20px; z-index:-1; opacity:0.3; }
    .upload-btn-wrap { margin-top:1.5rem; text-align:center; }
    .badge-row { display:flex; flex-wrap:wrap; gap:0.5rem; margin:1.5rem 0; }
    .badge { background:var(--grey-light); border:1px solid var(--grey-mid); color:var(--text-muted); font-weight:600; font-size:0.78rem; padding:0.35rem 0.9rem; border-radius:99px; letter-spacing:0.3px; }
    .fun-fact { background:linear-gradient(135deg,var(--purple),#6d28d9); color:var(--white); border-radius:16px; padding:1.25rem 1.5rem; margin-top:1.5rem; }
    .fun-fact-label { font-size:0.65rem; letter-spacing:3px; text-transform:uppercase; opacity:0.6; margin-bottom:0.4rem; font-weight:700; }
    .fun-fact-text { font-size:0.95rem; font-weight:500; line-height:1.6; }

    /* ── STATS ── */
    #stats { background:var(--deep); }
    .stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.05); border-radius:20px; overflow:hidden; }
    .stat-card { background:var(--deep); padding:2.5rem 1.5rem; text-align:center; transition:background 0.2s; }
    .stat-card:hover { background:rgba(124,58,237,0.08); }
    .stat-num { font-family:'Playfair Display',serif; font-size:3.2rem; color:var(--white); line-height:1; font-weight:700; }
    .stat-label { color:rgba(255,255,255,0.4); font-size:0.78rem; margin-top:0.5rem; font-weight:500; letter-spacing:1px; text-transform:uppercase; }

    /* ── VIDEO ── */
    #video { background:var(--black); }
    .video-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
    .video-card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07); border-radius:20px; overflow:hidden; transition:border-color 0.2s,transform 0.2s; }
    .video-card:hover { border-color:rgba(124,58,237,0.4); transform:translateY(-3px); }
    .video-embed { position:relative; padding-bottom:56.25%; background:#050008; }
    .video-embed iframe { position:absolute; inset:0; width:100%; height:100%; border:none; }
    .video-placeholder { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; color:rgba(255,255,255,0.2); gap:0.75rem; }
    .video-placeholder svg { width:40px; height:40px; }
    .video-placeholder p { font-size:0.85rem; font-weight:500; }
    .video-info { padding:1.5rem; border-top:1px solid rgba(255,255,255,0.06); }
    .video-info h3 { color:var(--white); font-weight:700; font-size:1rem; margin-bottom:0.3rem; }
    .video-info p { color:rgba(255,255,255,0.4); font-size:0.85rem; line-height:1.6; }
    .video-url-row { display:flex; gap:0.5rem; margin-top:1rem; }
    .video-url-row input { flex:1; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; color:rgba(255,255,255,0.8); padding:0.55rem 0.85rem; font-size:0.8rem; font-family:'Inter',sans-serif; transition:border-color 0.2s; }
    .video-url-row input:focus { outline:none; border-color:var(--purple); }
    .video-url-row input::placeholder { color:rgba(255,255,255,0.2); }
    .btn-load { background:var(--purple); color:var(--white); border:none; border-radius:8px; padding:0.55rem 1rem; font-size:0.8rem; font-weight:700; cursor:pointer; font-family:'Inter',sans-serif; white-space:nowrap; transition:background 0.2s; }
    .btn-load:hover { background:#6d28d9; }

    /* ── IDEAS ── */
    #ideas { background:var(--grey-light); }
    .ideas-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
    .idea-card {
      background:var(--white); border-radius:20px; padding:2rem;
      border:1px solid var(--grey-mid);
      transition:border-color 0.2s,transform 0.2s,box-shadow 0.2s;
      position:relative; overflow:hidden;
    }
    .idea-card:hover { border-color:var(--purple); transform:translateY(-4px); box-shadow:0 12px 40px rgba(0,0,0,0.08); }
    .idea-tag { display:inline-block; font-size:0.65rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--purple); background:rgba(124,58,237,0.08); padding:0.3rem 0.75rem; border-radius:99px; margin-bottom:1rem; }
    .idea-icon { font-size:2rem; margin-bottom:0.75rem; display:block; }
    .idea-card h3 { font-weight:700; font-size:1.05rem; color:var(--text); margin-bottom:0.6rem; line-height:1.3; }
    .idea-card p { color:var(--text-muted); font-size:0.88rem; line-height:1.7; }
    .add-idea-card { background:transparent; border:1.5px dashed var(--grey-mid); border-radius:20px; padding:2rem; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; cursor:pointer; transition:all 0.2s; gap:0.5rem; color:var(--text-muted); }
    .add-idea-card:hover { border-color:var(--purple); color:var(--purple); background:rgba(124,58,237,0.04); }
    .add-idea-card .add-icon { font-size:1.5rem; }
    .add-idea-card p { font-size:0.85rem; font-weight:600; }

    /* ── POLL ── */
    #poll { background:var(--white); }
    .poll-inner { max-width:680px; margin:0 auto; }
    .poll-note { background:rgba(124,58,237,0.06); border:1px solid rgba(124,58,237,0.15); border-radius:12px; padding:0.85rem 1.2rem; font-size:0.82rem; color:var(--purple); font-weight:600; margin-bottom:2rem; display:flex; align-items:center; gap:0.6rem; }
    .poll-option { display:flex; align-items:center; gap:1rem; padding:1rem 1.25rem; border:1px solid var(--grey-mid); border-radius:14px; margin-bottom:0.6rem; cursor:pointer; transition:all 0.2s; background:var(--grey-light); }
    .poll-option:hover { border-color:var(--purple); background:rgba(124,58,237,0.04); }
    .poll-option.voted { border-color:var(--purple); background:rgba(124,58,237,0.06); cursor:default; pointer-events:none; }
    .poll-label { font-weight:600; font-size:0.9rem; flex:1; }
    .poll-bar-wrap { flex:2; height:6px; background:var(--grey-mid); border-radius:99px; overflow:hidden; }
    .poll-bar { height:100%; background:linear-gradient(90deg,var(--purple),#a855f7); border-radius:99px; transition:width 0.6s ease; }
    .poll-pct { font-weight:700; font-size:0.85rem; color:var(--purple); min-width:3rem; text-align:right; }
    .poll-footer { margin-top:1rem; font-size:0.8rem; color:var(--text-muted); font-weight:500; }

    /* ── GALLERY ── */
    #gallery { background:var(--deep); }
    .gallery-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; }
    .gallery-slot { aspect-ratio:1; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07); border-radius:16px; overflow:hidden; position:relative; cursor:pointer; transition:all 0.2s; display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .gallery-slot:hover { border-color:rgba(124,58,237,0.5); background:rgba(124,58,237,0.08); }
    .gallery-slot img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:none; }
    .gallery-hint { color:rgba(255,255,255,0.2); font-size:0.75rem; text-align:center; }
    .gallery-hint svg { width:28px; height:28px; margin-bottom:0.4rem; display:block; margin-left:auto; margin-right:auto; }

    /* ── 100 DAYS ── */
    #plan { background:var(--black); }
    .plan-list { max-width:740px; margin:0 auto; }
    .plan-item { display:flex; gap:2rem; padding-bottom:2.5rem; position:relative; }
    .plan-item:not(:last-child)::after { content:''; position:absolute; left:1.35rem; top:2.7rem; bottom:0; width:1px; background:linear-gradient(to bottom,rgba(124,58,237,0.4),transparent); }
    .plan-num { width:2.7rem; height:2.7rem; flex-shrink:0; background:rgba(124,58,237,0.15); border:1px solid rgba(124,58,237,0.3); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:800; color:var(--purple-light); letter-spacing:0.5px; }
    .plan-body { flex:1; padding-top:0.2rem; }
    .plan-body h3 { color:var(--white); font-weight:700; font-size:1rem; margin-bottom:0.4rem; }
    .plan-body p { color:rgba(255,255,255,0.45); font-size:0.88rem; line-height:1.7; }

    /* ── ENDORSEMENTS ── */
    #endorse { background:var(--grey-light); }
    .endorse-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
    .endorse-card { background:var(--white); border-radius:20px; padding:2rem; border:1px solid var(--grey-mid); }
    .endorse-stars { color:var(--purple); font-size:0.8rem; margin-bottom:1rem; letter-spacing:2px; }
    .endorse-quote { font-size:0.93rem; color:#444; line-height:1.8; margin-bottom:1.5rem; font-style:italic; }
    .endorse-person { display:flex; align-items:center; gap:0.75rem; }
    .endorse-avatar { width:38px; height:38px; background:linear-gradient(135deg,var(--purple),#a855f7); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1rem; color:white; font-weight:700; flex-shrink:0; }
    .endorse-name { font-weight:700; font-size:0.88rem; color:var(--text); }
    .endorse-role { font-size:0.75rem; color:var(--text-muted); margin-top:0.1rem; }

    /* ── WALL OF SUPPORT ── */
    #support { background:var(--deep); }
    .support-inner { max-width:760px; margin:0 auto; }
    .support-input-row { display:flex; gap:0.75rem; margin-bottom:2rem; }
    .support-input-row input { flex:1; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:12px; color:var(--white); padding:0.85rem 1.1rem; font-family:'Inter',sans-serif; font-size:0.9rem; transition:border-color 0.2s; }
    .support-input-row input::placeholder { color:rgba(255,255,255,0.25); }
    .support-input-row input:focus { outline:none; border-color:var(--purple); }
    .support-wall { display:flex; flex-wrap:wrap; gap:0.6rem; min-height:48px; }
    .support-chip { background:rgba(124,58,237,0.12); border:1px solid rgba(124,58,237,0.25); color:rgba(255,255,255,0.75); border-radius:99px; padding:0.4rem 1rem; font-size:0.82rem; font-weight:600; animation:popIn 0.3s ease; }
    @keyframes popIn { from{transform:scale(0.7);opacity:0} to{transform:scale(1);opacity:1} }
    .support-count { margin-top:1.25rem; font-size:0.8rem; color:rgba(255,255,255,0.3); font-weight:500; }

    /* ── BLOG ── */
    #blog { background:var(--grey-light); }
    .blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
    .blog-card { background:var(--white); border-radius:20px; overflow:hidden; border:1px solid var(--grey-mid); transition:transform 0.2s,box-shadow 0.2s; }
    .blog-card:hover { transform:translateY(-3px); box-shadow:0 10px 32px rgba(0,0,0,0.07); }
    .blog-top { background:linear-gradient(135deg,var(--purple),#6d28d9); padding:1.5rem; }
    .blog-date { font-size:0.7rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.6); margin-bottom:0.4rem; }
    .blog-body { padding:1.5rem; }
    .blog-body h3 { font-weight:700; font-size:1rem; color:var(--text); margin-bottom:0.5rem; line-height:1.3; }
    .blog-body p { font-size:0.85rem; color:var(--text-muted); line-height:1.7; }
    .blog-add { background:transparent; border:1.5px dashed var(--grey-mid); border-radius:20px; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; cursor:pointer; padding:2.5rem 2rem; gap:0.5rem; transition:all 0.2s; color:var(--text-muted); }
    .blog-add:hover { border-color:var(--purple); color:var(--purple); background:rgba(124,58,237,0.04); }

    /* ── SUGGEST ── */
    #recommend { background:var(--white); }
    .rec-inner { max-width:640px; margin:0 auto; }
    .form-group { margin-bottom:1.1rem; }
    .form-label { display:block; font-weight:600; font-size:0.82rem; color:var(--text); margin-bottom:0.45rem; letter-spacing:0.3px; }
    .form-input { width:100%; background:var(--grey-light); border:1.5px solid var(--grey-mid); border-radius:12px; padding:0.8rem 1rem; font-size:0.9rem; font-family:'Inter',sans-serif; color:var(--text); transition:border-color 0.2s,background 0.2s; }
    .form-input:focus { outline:none; border-color:var(--purple); background:var(--white); }
    textarea.form-input { resize:vertical; min-height:120px; }
    .rec-cards { display:flex; flex-direction:column; gap:0.75rem; margin-top:2rem; }
    .rec-card { background:var(--grey-light); border-radius:14px; padding:1.1rem 1.25rem; border-left:3px solid var(--purple); animation:slideIn 0.4s ease; }
    @keyframes slideIn { from{opacity:0;transform:translateX(-16px)} to{opacity:1;transform:translateX(0)} }
    .rec-category { font-size:0.68rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--purple); margin-bottom:0.25rem; }
    .rec-author { font-weight:700; font-size:0.88rem; color:var(--text); }
    .rec-text { font-size:0.85rem; color:var(--text-muted); margin-top:0.25rem; line-height:1.6; }
    .success-toast { background:#f5f0ff; border:1px solid rgba(124,58,237,0.3); border-radius:12px; padding:1rem 1.25rem; color:var(--purple); font-weight:600; font-size:0.88rem; display:none; margin-top:1rem; text-align:center; }

    /* ── FAQ ── */
    #faq { background:var(--grey-light); }
    .faq-list { max-width:700px; margin:0 auto; }
    .faq-item { background:var(--white); border:1px solid var(--grey-mid); border-radius:16px; margin-bottom:0.6rem; overflow:hidden; transition:border-color 0.2s; }
    .faq-item.open { border-color:var(--purple); }
    .faq-q { padding:1.1rem 1.4rem; font-weight:600; font-size:0.9rem; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:1rem; color:var(--text); transition:color 0.2s; }
    .faq-q:hover { color:var(--purple); }
    .faq-arrow { width:20px; height:20px; border:1.5px solid currentColor; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform 0.3s,border-color 0.2s; color:var(--text-muted); }
    .faq-arrow svg { width:10px; height:10px; transition:transform 0.3s; }
    .faq-item.open .faq-arrow { border-color:var(--purple); color:var(--purple); transform:rotate(180deg); }
    .faq-a { max-height:0; overflow:hidden; transition:max-height 0.4s ease,padding 0.3s; padding:0 1.4rem; font-size:0.88rem; color:var(--text-muted); line-height:1.8; }
    .faq-item.open .faq-a { max-height:300px; padding:0 1.4rem 1.2rem; }

    /* ── SHARE BAR ── */
    .share-strip { background:var(--purple); padding:1.5rem 2rem; display:flex; align-items:center; justify-content:center; gap:1.5rem; flex-wrap:wrap; }
    .share-strip p { color:rgba(255,255,255,0.85); font-size:0.9rem; font-weight:500; }
    .share-btn { background:var(--white); color:var(--purple); border:none; border-radius:99px; padding:0.55rem 1.4rem; font-weight:700; font-size:0.82rem; cursor:pointer; font-family:'Inter',sans-serif; transition:transform 0.2s; }
    .share-btn:hover { transform:scale(1.04); }
    .share-copied { font-size:0.78rem; color:rgba(255,255,255,0.7); display:none; }

    /* ── FOOTER ── */
    footer { background:var(--black); border-top:1px solid rgba(255,255,255,0.05); padding:4rem 2rem; }
    .footer-inner { max-width:1140px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:2rem; }
    .footer-brand { font-family:'Playfair Display',serif; font-size:1.4rem; color:var(--white); font-weight:700; }
    .footer-brand span { color:var(--purple-light); }
    .footer-meta { color:rgba(255,255,255,0.25); font-size:0.8rem; line-height:1.8; }
    .footer-links { display:flex; gap:1.5rem; }
    .footer-links a { color:rgba(255,255,255,0.3); font-size:0.8rem; text-decoration:none; transition:color 0.2s; }
    .footer-links a:hover { color:var(--purple-light); }

    /* ── EDITABLE ── */
    [contenteditable="true"] { outline:none; cursor:text; border-bottom:1.5px dashed transparent; transition:border-color 0.2s,background 0.2s; border-radius:3px; padding:1px 3px; }
    [contenteditable="true"]:hover { border-bottom-color:rgba(124,58,237,0.4); }
    [contenteditable="true"]:focus { border-bottom-color:var(--purple); background:rgba(124,58,237,0.05); }
    .edit-tip { position:fixed; bottom:1.5rem; right:1.5rem; background:var(--deep); color:var(--purple-light); font-size:0.75rem; font-weight:600; padding:0.55rem 1.1rem; border-radius:99px; border:1px solid rgba(124,58,237,0.25); box-shadow:0 4px 20px rgba(0,0,0,0.3); z-index:998; letter-spacing:0.5px; }

    /* ── RESPONSIVE ── */
    @media(max-width:1024px) { .meet-grid { grid-template-columns:1fr 1fr; gap:3rem; } }
    @media(max-width:900px) {
      .stats-grid { grid-template-columns:repeat(2,1fr); }
      .gallery-grid { grid-template-columns:repeat(2,1fr); }
      .endorse-grid, .blog-grid { grid-template-columns:1fr 1fr; }
      .ideas-grid { grid-template-columns:1fr 1fr; }
    }
    @media(max-width:700px) {
