<script>
// Dark mode
function toggleDark() {
  document.body.classList.toggle('dark');
  document.querySelector('.dark-toggle').textContent = document.body.classList.contains('dark') ? '☀️ Light' : '🌙 Dark';
}

// Photo upload
document.getElementById('photo-input').addEventListener('change', function(e) {
  const file = e.target.files[0]; if(!file) return;
  const r = new FileReader();
  r.onload = ev => {
    const img = document.getElementById('candidate-photo');
    img.src = ev.target.result; img.style.display = 'block';
    document.getElementById('photo-placeholder').style.display = 'none';
  };
  r.readAsDataURL(file);
});

// Gallery
let currentSlot = 0;
function uploadGalleryPhoto(idx) { currentSlot = idx; document.getElementById('gallery-input').click(); }
document.getElementById('gallery-input').addEventListener('change', function(e) {
  const file = e.target.files[0]; if(!file) return;
  const r = new FileReader();
  r.onload = ev => {
    const img = document.getElementById('gimg-' + currentSlot);
    img.src = ev.target.result; img.style.display = 'block';
    img.parentElement.querySelector('.gallery-hint').style.display = 'none';
  };
  r.readAsDataURL(file); this.value = '';
});

// YouTube
function getYTId(url) {
  const m = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/ ]{11})/);
  return m ? m[1] : null;
}
function loadVideo(n) {
  const id = getYTId(document.getElementById('url'+n).value);
  if(!id){ alert('Please paste a valid YouTube URL.'); return; }
  document.getElementById('iframe'+n).src = 'https://www.youtube.com/embed/'+id;
  document.getElementById('iframe'+n).style.display = 'block';
  document.getElementById('placeholder'+n).style.display = 'none';
}

// Badges
function addBadge() {
  const b = document.createElement('span'); b.className='badge'; b.contentEditable='true'; b.textContent='New Tag';
  document.getElementById('badge-row').insertBefore(b, document.getElementById('badge-row').lastElementChild); b.focus();
}

// Ideas
function addIdeaCard() {
  const grid = document.getElementById('ideas-grid');
  const card = document.createElement('div'); card.className='idea-card';
  card.innerHTML='<span class="idea-icon" contenteditable="true">💡</span><h3 contenteditable="true">New Idea</h3><p contenteditable="true">Click to describe your idea here.</p>';
  grid.insertBefore(card, grid.lastElementChild); card.querySelector('h3').focus();
}

// Poll
const votes=[0,0,0,0,0]; let voted=false;
function castVote(i) {
  if(voted) return; voted=true; votes[i]++;
  const total=votes.reduce((a,b)=>a+b,0);
  votes.forEach((v,j)=>{
    const p=total?Math.round(v/total*100):0;
    document.getElementById('bar-'+j).style.width=p+'%';
    document.getElementById('pct-'+j).textContent=p+'%';
    document.querySelectorAll('.poll-option')[j].classList.add('voted');
  });
  document.getElementById('poll-total').textContent=total+' straw vote'+(total!==1?'s':'')+' cast';
}

// Wall of support
const supporters=[];
function addSupporter() {
  const n=document.getElementById('support-name').value.trim(); if(!n) return;
  supporters.push(n); document.getElementById('support-name').value='';
  document.getElementById('support-wall').innerHTML=supporters.map(s=>`<div class="support-chip">🐾 ${s}</div>`).join('');
  document.getElementById('support-count').textContent=supporters.length+' Wildcat'+(supporters.length!==1?'s':'')+' standing with David';
}

// FAQ
function toggleFaq(el) { el.parentElement.classList.toggle('open'); }

// Blog
function addBlogPost() {
  const grid=document.getElementById('blog-grid');
  const today=new Date().toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
  const card=document.createElement('div'); card.className='blog-card';
  card.innerHTML=`<div class="blog-top"><div class="blog-date" contenteditable="true">${today}</div></div><div class="blog-body"><h3 contenteditable="true">New Update</h3><p contenteditable="true">Write your update here.</p></div>`;
  grid.insertBefore(card,grid.lastElementChild); card.querySelector('h3').focus();
}

// Suggestions
const subs=[];
function submitRec() {
  const name=document.getElementById('rec-name').value.trim()||'Anonymous Wildcat';
  const cat=document.getElementById('rec-category').value;
  const text=document.getElementById('rec-text').value.trim();
  if(!text){alert('Please write your suggestion first!');return;}
  subs.unshift({name,cat,text});
  document.getElementById('rec-name').value=''; document.getElementById('rec-text').value='';
  document.getElementById('rec-cards').innerHTML=subs.map(s=>`<div class="rec-card"><div class="rec-category">${s.cat}</div><div class="rec-author">${s.name}</div><div class="rec-text">${s.text}</div></div>`).join('');
  const msg=document.getElementById('success-msg'); msg.style.display='block'; setTimeout(()=>msg.style.display='none',4000);
}

// Share
function shareLink() {
  navigator.clipboard.writeText(window.location.href).then(()=>{
    const el=document.getElementById('share-copied'); el.style.display='inline'; setTimeout(()=>el.style.display='none',3000);
  });
}

// Countdown
let target=null;
function setElectionDate(v) {
  if(!v) return; target=new Date(v+'T08:00:00');
}
function tick() {
  if(!target){['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id=>document.getElementById(id).textContent='--');return;}
  const diff=target-new Date();
  if(diff<=0){document.getElementById('cd-days').textContent='🎉';document.getElementById('cd-hours').textContent='GO';document.getElementById('cd-mins').textContent='VOTE';document.getElementById('cd-secs').textContent='NOW';return;}
  const pad=n=>String(Math.floor(n)).padStart(2,'0');
  document.getElementById('cd-days').textContent=pad(diff/86400000);
  document.getElementById('cd-hours').textContent=pad((diff%86400000)/3600000);
  document.getElementById('cd-mins').textContent=pad((diff%3600000)/60000);
  document.getElementById('cd-secs').textContent=pad((diff%60000)/1000);
}
setInterval(tick,1000); tick();
</script>
